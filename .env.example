# NearDonor environment variables (copy to .env)

# Supabase (REQUIRED - the app will show a "backend not configured" state without these)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS project id (used by expo-notifications to mint Expo push tokens).
# Found in your Expo project settings, or the "extra.eas.projectId" in app.json.
EXPO_PUBLIC_EAS_PROJECT_ID=
